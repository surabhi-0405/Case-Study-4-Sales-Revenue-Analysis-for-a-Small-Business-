CREATE DATABASE TrendMart_Analytics;
USE TrendMart_Analytics;
--------------------------------------------------------------------------------------------------------------------------------
CREATE TABLE Customers (
    Customer_ID VARCHAR(10) PRIMARY KEY,
    Name VARCHAR(100),
    Age INT,
    Gender VARCHAR(20),
    Location VARCHAR(50),
    Total_Spent DECIMAL(10,2)
);
--------------------------------------------------------------------------------------------------------------------------------
CREATE TABLE Sales (
    Transaction_ID VARCHAR(20) PRIMARY KEY,
    Date DATETIME,
    Customer_ID VARCHAR(10),
    Product_Category VARCHAR(50),
    Product_Name VARCHAR(100),
    Quantity INT,
    Unit_Price DECIMAL(10,2),
    Total_Amount DECIMAL(10,2),
    Payment_Method VARCHAR(30),
    FOREIGN KEY (Customer_ID) REFERENCES Customers(Customer_ID)
);
--------------------------------------------------------------------------------------------------------------------------------
CREATE TABLE Customer_Metrics (
    Customer_ID VARCHAR(10) PRIMARY KEY,
    Transaction_Frequency INT,
    Total_Revenue DECIMAL(12,2),
    Average_Transaction_Value DECIMAL(12,2),
    Revenue_Segment VARCHAR(30),
    Customer_Segment VARCHAR(30),
    FOREIGN KEY (Customer_ID) REFERENCES Customers(Customer_ID)
);
--------------------------------------------------------------------------------------------------------------------------------
SELECT 
    COUNT(*) AS Total_Sales_Rows,
    COUNT(DISTINCT Transaction_ID) AS Unique_Transactions,
    COUNT(DISTINCT Customer_ID) AS Unique_Customers
FROM Sales;
--------------------------------------------------------------------------------------------------------------------------------
SELECT 
    COUNT(*) AS Total_Sales_Rows,
    COUNT(DISTINCT Transaction_ID) AS Unique_Transactions,
    COUNT(DISTINCT Customer_ID) AS Unique_Customers
FROM Sales;
--------------------------------------------------------------------------------------------------------------------------------
SELECT 
    COUNT(*) AS Total_Sales_Rows,
    COUNT(DISTINCT Transaction_ID) AS Unique_Transactions,
    COUNT(DISTINCT Customer_ID) AS Unique_Customers
FROM Sales;
--------------------------------------------------------------------------------------------------------------------------------
SELECT 
    COUNT(*) AS Total_Customers,
    COUNT(DISTINCT Customer_ID) AS Unique_Customer_IDs
FROM Customers;
--------------------------------------------------------------------------------------------------------------------------------
SELECT
    (SELECT COUNT(*) FROM Customers) AS Customers_Rows,
    (SELECT COUNT(DISTINCT Customer_ID) FROM Customers) AS Unique_Customers,

    (SELECT COUNT(*) FROM Sales) AS Sales_Rows,
    (SELECT COUNT(DISTINCT Transaction_ID) FROM Sales) AS Unique_Transactions,

    (SELECT COUNT(*) FROM Customer_Metrics) AS Metrics_Rows,
    (SELECT COUNT(DISTINCT Customer_ID) FROM Customer_Metrics) AS Metrics_Customers;
--------------------------------------------------------------------------------------------------------------------------------
SELECT 
    SUM(Total_Amount) AS Total_Revenue
FROM Sales;
--------------------------------------------------------------------------------------------------------------------------------
SELECT
    DATE_FORMAT(Date, '%Y-%m') AS Month,
    COUNT(*) AS Transactions,
    SUM(Quantity) AS Quantity_Sold,
    SUM(Total_Amount) AS Revenue
FROM Sales
GROUP BY DATE_FORMAT(Date, '%Y-%m')
ORDER BY Month;
--------------------------------------------------------------------------------------------------------------------------------
SELECT
    Product_Category,
    COUNT(*) AS Transactions,
    SUM(Quantity) AS Quantity_Sold,
    SUM(Total_Amount) AS Revenue,
    ROUND(AVG(Total_Amount), 2) AS Avg_Transaction_Value
FROM Sales
GROUP BY Product_Category
ORDER BY Revenue DESC;
--------------------------------------------------------------------------------------------------------------------------------
SELECT
    Product_Name,
    COUNT(*) AS Transactions,
    SUM(Quantity) AS Quantity_Sold,
    SUM(Total_Amount) AS Revenue,
    ROUND(AVG(Total_Amount), 2) AS Avg_Transaction_Value
FROM Sales
GROUP BY Product_Name
ORDER BY Revenue DESC;
--------------------------------------------------------------------------------------------------------------------------------
SELECT
    Payment_Method,
    COUNT(*) AS Transactions,
    SUM(Quantity) AS Quantity_Sold,
    SUM(Total_Amount) AS Revenue,
    ROUND(AVG(Total_Amount), 2) AS Avg_Transaction_Value
FROM Sales
GROUP BY Payment_Method
ORDER BY Revenue DESC;
--------------------------------------------------------------------------------------------------------------------------------
SELECT
    c.Location,
    COUNT(s.Transaction_ID) AS Transactions,
    SUM(s.Quantity) AS Quantity_Sold,
    SUM(s.Total_Amount) AS Revenue,
    ROUND(AVG(s.Total_Amount), 2) AS Avg_Transaction_Value
FROM Sales s
JOIN Customers c
    ON s.Customer_ID = c.Customer_ID
GROUP BY c.Location
ORDER BY Revenue DESC;
--------------------------------------------------------------------------------------------------------------------------------
SELECT
    Customer_ID,
    COUNT(Transaction_ID) AS Transaction_Frequency,
    SUM(Total_Amount) AS Total_Revenue,
    ROUND(AVG(Total_Amount), 2) AS Average_Transaction_Value
FROM Sales
GROUP BY Customer_ID
ORDER BY Total_Revenue DESC;
--------------------------------------------------------------------------------------------------------------------------------
SELECT
    Customer_Segment,
    COUNT(*) AS Customer_Count,
    ROUND(AVG(Transaction_Frequency), 2) AS Avg_Transaction_Frequency,
    ROUND(AVG(Total_Revenue), 2) AS Avg_Total_Revenue,
    ROUND(SUM(Total_Revenue), 2) AS Segment_Revenue
FROM Customer_Metrics
GROUP BY Customer_Segment
ORDER BY Segment_Revenue DESC;
--------------------------------------------------------------------------------------------------------------------------------
SELECT
    Customer_ID,
    COUNT(Transaction_ID) AS Transaction_Frequency,
    ROUND(SUM(Total_Amount), 2) AS Historical_CLV
FROM Sales
GROUP BY Customer_ID
ORDER BY Historical_CLV DESC;
--------------------------------------------------------------------------------------------------------------------------------
SELECT
    COUNT(*) AS Total_Customers,
    ROUND(AVG(Historical_CLV), 2) AS Average_Historical_CLV,
    ROUND(MAX(Historical_CLV), 2) AS Maximum_Historical_CLV,
    ROUND(MIN(Historical_CLV), 2) AS Minimum_Historical_CLV
FROM (
    SELECT
        Customer_ID,
        SUM(Total_Amount) AS Historical_CLV
    FROM Sales
    GROUP BY Customer_ID
) AS Customer_CLV;
--------------------------------------------------------------------------------------------------------------------------------
SELECT
    Customer_Segment,
    COUNT(*) AS Customer_Count,
    ROUND(AVG(Total_Revenue), 2) AS Average_CLV,
    ROUND(MAX(Total_Revenue), 2) AS Maximum_CLV,
    ROUND(SUM(Total_Revenue), 2) AS Segment_Revenue
FROM Customer_Metrics
GROUP BY Customer_Segment
ORDER BY Average_CLV DESC;
--------------------------------------------------------------------------------------------------------------------------------
WITH Monthly_Revenue AS (
    SELECT
        DATE_FORMAT(Date, '%Y-%m') AS Month,
        SUM(Total_Amount) AS Revenue
    FROM Sales
    GROUP BY DATE_FORMAT(Date, '%Y-%m')
)
SELECT
    Month,
    ROUND(Revenue, 2) AS Revenue,
    ROUND(
        ((Revenue - LAG(Revenue) OVER (ORDER BY Month))
        / LAG(Revenue) OVER (ORDER BY Month)) * 100,
        2
    ) AS MoM_Growth_Percentage
FROM Monthly_Revenue
ORDER BY Month;
--------------------------------------------------------------------------------------------------------------------------------
SELECT
    Customer_Segment,
    COUNT(*) AS Customer_Count,
    ROUND(SUM(Total_Revenue), 2) AS Segment_Revenue,
    ROUND(
        (SUM(Total_Revenue) / (SELECT SUM(Total_Revenue) FROM Customer_Metrics)) * 100,
        2
    ) AS Revenue_Contribution_Percentage
FROM Customer_Metrics
GROUP BY Customer_Segment
ORDER BY Segment_Revenue DESC;
--------------------------------------------------------------------------------------------------------------------------------
SELECT
    c.Gender,
    COUNT(DISTINCT c.Customer_ID) AS Customer_Count,
    COUNT(s.Transaction_ID) AS Transactions,
    ROUND(SUM(s.Total_Amount), 2) AS Revenue,
    ROUND(AVG(s.Total_Amount), 2) AS Average_Transaction_Value
FROM Customers c
JOIN Sales s
    ON c.Customer_ID = s.Customer_ID
GROUP BY c.Gender
ORDER BY Revenue DESC;
--------------------------------------------------------------------------------------------------------------------------------
SELECT
    c.Location,
    COUNT(DISTINCT c.Customer_ID) AS Customer_Count,
    COUNT(s.Transaction_ID) AS Transactions,
    ROUND(SUM(s.Total_Amount), 2) AS Revenue,
    ROUND(AVG(s.Total_Amount), 2) AS Average_Transaction_Value
FROM Customers c
JOIN Sales s
    ON c.Customer_ID = s.Customer_ID
GROUP BY c.Location
ORDER BY Revenue DESC;
--------------------------------------------------------------------------------------------------------------------------------
SELECT
    Payment_Method,
    COUNT(*) AS Transactions,
    SUM(Quantity) AS Quantity_Sold,
    ROUND(SUM(Total_Amount), 2) AS Revenue,
    ROUND(AVG(Total_Amount), 2) AS Average_Transaction_Value
FROM Sales
GROUP BY Payment_Method
ORDER BY Revenue DESC;
--------------------------------------------------------------------------------------------------------------------------------
SELECT
    Customer_ID,
    COUNT(Transaction_ID) AS Transaction_Frequency,
    ROUND(SUM(Total_Amount), 2) AS Historical_CLV
FROM Sales
GROUP BY Customer_ID
ORDER BY Historical_CLV DESC
LIMIT 10;
--------------------------------------------------------------------------------------------------------------------------------
SELECT
    Product_Category,
    ROUND(SUM(Total_Amount), 2) AS Revenue,
    ROUND(
        (SUM(Total_Amount) / (SELECT SUM(Total_Amount) FROM Sales)) * 100,
        2
    ) AS Revenue_Contribution_Percentage
FROM Sales
GROUP BY Product_Category
ORDER BY Revenue DESC;
--------------------------------------------------------------------------------------------------------------------------------
SELECT
    Product_Name,
    COUNT(*) AS Transactions,
    SUM(Quantity) AS Quantity_Sold,
    ROUND(SUM(Total_Amount), 2) AS Revenue,
    ROUND(AVG(Total_Amount), 2) AS Average_Transaction_Value
FROM Sales
GROUP BY Product_Name
ORDER BY Revenue DESC;
--------------------------------------------------------------------------------------------------------------------------------
SELECT
    Product_Category,
    Payment_Method,
    COUNT(*) AS Transactions,
    ROUND(SUM(Total_Amount), 2) AS Revenue
FROM Sales
GROUP BY Product_Category, Payment_Method
ORDER BY Product_Category, Revenue DESC;
--------------------------------------------------------------------------------------------------------------------------------
SELECT
    DATE_FORMAT(Date, '%Y-%m') AS Month,
    Product_Category,
    COUNT(*) AS Transactions,
    ROUND(SUM(Total_Amount), 2) AS Revenue
FROM Sales
GROUP BY
    DATE_FORMAT(Date, '%Y-%m'),
    Product_Category
ORDER BY
    Month,
    Revenue DESC;
--------------------------------------------------------------------------------------------------------------------------------
SELECT
    Transaction_Frequency,
    COUNT(*) AS Customer_Count
FROM Customer_Metrics
GROUP BY Transaction_Frequency
ORDER BY Transaction_Frequency;
--------------------------------------------------------------------------------------------------------------------------------
SELECT
    Transaction_Frequency,
    COUNT(*) AS Customer_Count,
    ROUND(AVG(Total_Revenue), 2) AS Average_Revenue,
    ROUND(SUM(Total_Revenue), 2) AS Total_Revenue
FROM Customer_Metrics
GROUP BY Transaction_Frequency
ORDER BY Transaction_Frequency;
--------------------------------------------------------------------------------------------------------------------------------
SELECT
    Product_Category,
    COUNT(*) AS Transactions,
    ROUND(AVG(Total_Amount), 2) AS Average_Order_Value,
    ROUND(SUM(Total_Amount), 2) AS Total_Revenue
FROM Sales
GROUP BY Product_Category
ORDER BY Average_Order_Value DESC;

--------------------------------------------------------------------------------------------------------------------------------
SELECT
    Product_Name,
    COUNT(*) AS Transactions,
    SUM(Quantity) AS Quantity_Sold,
    ROUND(AVG(Total_Amount), 2) AS Average_Order_Value,
    ROUND(SUM(Total_Amount), 2) AS Total_Revenue
FROM Sales
GROUP BY Product_Name
ORDER BY Total_Revenue DESC;
--------------------------------------------------------------------------------------------------------------------------------
SELECT
    c.Gender,
    COUNT(DISTINCT c.Customer_ID) AS Customer_Count,
    COUNT(s.Transaction_ID) AS Transactions,
    SUM(s.Quantity) AS Quantity_Sold,
    ROUND(SUM(s.Total_Amount), 2) AS Total_Revenue,
    ROUND(AVG(s.Total_Amount), 2) AS Average_Order_Value
FROM Customers c
JOIN Sales s
    ON c.Customer_ID = s.Customer_ID
GROUP BY c.Gender
ORDER BY Total_Revenue DESC;
--------------------------------------------------------------------------------------------------------------------------------
SELECT
    c.Location,
    COUNT(DISTINCT c.Customer_ID) AS Customer_Count,
    COUNT(s.Transaction_ID) AS Transactions,
    SUM(s.Quantity) AS Quantity_Sold,
    ROUND(SUM(s.Total_Amount), 2) AS Total_Revenue,
    ROUND(AVG(s.Total_Amount), 2) AS Average_Order_Value
FROM Customers c
JOIN Sales s
    ON c.Customer_ID = s.Customer_ID
GROUP BY c.Location
ORDER BY Total_Revenue DESC;
--------------------------------------------------------------------------------------------------------------------------------
SELECT
    Revenue_Segment,
    COUNT(*) AS Customer_Count,
    ROUND(AVG(Total_Revenue), 2) AS Average_Revenue,
    ROUND(SUM(Total_Revenue), 2) AS Total_Revenue
FROM Customer_Metrics
GROUP BY Revenue_Segment
ORDER BY Average_Revenue;
--------------------------------------------------------------------------------------------------------------------------------
SELECT
    Customer_Segment,
    COUNT(*) AS Customer_Count,
    ROUND(SUM(Total_Revenue), 2) AS Segment_Revenue,
    ROUND(
        (SUM(Total_Revenue) /
        (SELECT SUM(Total_Revenue) FROM Customer_Metrics)) * 100,
        2
    ) AS Revenue_Contribution_Percentage
FROM Customer_Metrics
GROUP BY Customer_Segment
ORDER BY Revenue_Contribution_Percentage DESC;
--------------------------------------------------------------------------------------------------------------------------------
SELECT
    Payment_Method,
    COUNT(*) AS Transactions,
    SUM(Quantity) AS Quantity_Sold,
    ROUND(SUM(Total_Amount), 2) AS Total_Revenue,
    ROUND(AVG(Total_Amount), 2) AS Average_Order_Value
FROM Sales
GROUP BY Payment_Method
ORDER BY Total_Revenue DESC;
--------------------------------------------------------------------------------------------------------------------------------
SELECT
    Customer_ID,
    COUNT(Transaction_ID) AS Transaction_Frequency,
    ROUND(SUM(Total_Amount), 2) AS Historical_Revenue,
    ROUND(AVG(Total_Amount), 2) AS Average_Order_Value
FROM Sales
GROUP BY Customer_ID
ORDER BY Historical_Revenue DESC
LIMIT 10;
--------------------------------------------------------------------------------------------------------------------------------
SELECT
    Product_Category,
    ROUND(SUM(Total_Amount), 2) AS Total_Revenue,
    ROUND(
        (SUM(Total_Amount) / (SELECT SUM(Total_Amount) FROM Sales)) * 100,
        2
    ) AS Revenue_Contribution_Percentage
FROM Sales
GROUP BY Product_Category
ORDER BY Total_Revenue DESC;
--------------------------------------------------------------------------------------------------------------------------------
SELECT
    DATE_FORMAT(Date, '%Y-%m') AS Month,
    COUNT(*) AS Transactions,
    SUM(Quantity) AS Quantity_Sold,
    ROUND(SUM(Total_Amount), 2) AS Total_Revenue,
    ROUND(AVG(Total_Amount), 2) AS Average_Order_Value
FROM Sales
GROUP BY DATE_FORMAT(Date, '%Y-%m')
ORDER BY Month;
--------------------------------------------------------------------------------------------------------------------------------
SELECT
    (SELECT COUNT(*) FROM Customers) AS Total_Customers,
    (SELECT COUNT(*) FROM Sales) AS Total_Transactions,
    (SELECT COUNT(*) FROM Customer_Metrics) AS Total_Customer_Metrics;

